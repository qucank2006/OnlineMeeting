<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.onlinemeeting.controller.LoginController"
           style="-fx-background-color: #1e1e2e; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px;">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <VBox alignment="CENTER_LEFT" maxWidth="420" maxHeight="-Infinity" spacing="10"
          style="-fx-background-color: #181825; -fx-background-radius: 20; -fx-border-color: #313244; -fx-border-radius: 20;">
        <padding>
            <Insets top="28" right="32" bottom="24" left="32"/>
        </padding>
        <Label text="ONLINE MEETING"
               style="-fx-text-fill: #cba6f7; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        <Label text="Chào mừng trở lại"
               style="-fx-text-fill: #cdd6f4; -fx-font-size: 28px; -fx-font-weight: bold;"/>
        <Label text="Đăng nhập để bắt đầu cuộc họp." wrapText="true"
               style="-fx-text-fill: #a6adc8; -fx-padding: 0 0 8 0;"/>
        <Label text="Tên đăng nhập hoặc email"
               style="-fx-text-fill: #bac2de;"/>
        <TextField fx:id="usernameField" promptText="Tên đăng nhập hoặc email"
                   accessibleText="Tên đăng nhập hoặc email" prefHeight="44"
                   onAction="#handleLogin"
                   style="-fx-background-color: #313244; -fx-background-radius: 8; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #a6adc8; -fx-highlight-fill: #585b70; -fx-padding: 10 12;"/>
        <Label text="Mật khẩu"
               style="-fx-text-fill: #bac2de;"/>
        <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu"
                       accessibleText="Mật khẩu" prefHeight="44"
                       onAction="#handleLogin"
                       style="-fx-background-color: #313244; -fx-background-radius: 8; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #a6adc8; -fx-highlight-fill: #585b70; -fx-padding: 10 12;"/>
        <Button fx:id="loginButton" text="Đăng nhập" defaultButton="true"
                prefHeight="44" maxWidth="Infinity" onAction="#handleLogin"
                style="-fx-background-color: #cba6f7; -fx-text-fill: #11111b; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button fx:id="createAccountButton" text="Tạo tài khoản / Create account"
                maxWidth="Infinity" onAction="#handleCreateAccount"
                style="-fx-background-color: transparent; -fx-text-fill: #89b4fa; -fx-cursor: hand; -fx-padding: 6;"/>
        <Label fx:id="errorLabel" text="" wrapText="true" minHeight="40"
               maxWidth="Infinity" style="-fx-text-fill: #f38ba8;"/>
    </VBox>
</StackPane>
