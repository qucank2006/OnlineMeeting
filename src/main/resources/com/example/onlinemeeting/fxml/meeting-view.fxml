<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.example.onlinemeeting.controller.MeetingController"
        style="-fx-background-color: #202124;">

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                style="-fx-background-color: #292a2d;">

            <padding>
                <Insets
                        top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label
                    text="OnlineMeeting"
                    style="-fx-text-fill: white;">

                <font>
                    <Font size="20"/>
                </font>

            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <Label
                    fx:id="roomIdLabel"
                    style="-fx-text-fill: white;"/>

        </HBox>

    </top>


    <center>

        <HBox spacing="10">

            <padding>
                <Insets
                        top="15"
                        right="15"
                        bottom="15"
                        left="15"/>
            </padding>

            <!-- PARTICIPANTS -->

            <GridPane
                    fx:id="participantsGrid"
                    alignment="CENTER"
                    hgap="12"
                    vgap="12"
                    HBox.hgrow="ALWAYS">

                <columnConstraints>

                    <ColumnConstraints
                            percentWidth="50"
                            hgrow="ALWAYS"/>

                    <ColumnConstraints
                            percentWidth="50"
                            hgrow="ALWAYS"/>

                </columnConstraints>

                <rowConstraints>

                    <RowConstraints
                            percentHeight="50"
                            vgrow="ALWAYS"/>

                    <RowConstraints
                            percentHeight="50"
                            vgrow="ALWAYS"/>

                </rowConstraints>

            </GridPane>


            <!-- CHAT -->

            <VBox
                    prefWidth="300"
                    minWidth="260"
                    maxWidth="320"
                    spacing="10"
                    style="
                    -fx-background-color: #292a2d;
                    -fx-background-radius: 10;
                ">

                <padding>
                    <Insets
                            top="15"
                            right="15"
                            bottom="15"
                            left="15"/>
                </padding>

                <Label
                        text="Chat"
                        style="
                        -fx-text-fill: white;
                        -fx-font-size: 18px;
                        -fx-font-weight: bold;
                    "/>

                <Separator/>

                <ScrollPane
                        fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;">

                    <VBox
                            fx:id="chatBox"
                            spacing="10"
                            fillWidth="true"/>

                </ScrollPane>

                <HBox spacing="8">

                    <TextField
                            fx:id="messageField"
                            promptText="Nhập tin nhắn..."
                            HBox.hgrow="ALWAYS"
                            onAction="#handleSendMessage"/>

                    <Button
                            text="Gửi"
                            onAction="#handleSendMessage"/>

                </HBox>

            </VBox>

        </HBox>

    </center>


    <bottom>

        <VBox
                alignment="CENTER"
                spacing="10"
                style="-fx-background-color: #292a2d;">

            <padding>
                <Insets
                        top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <HBox
                    alignment="CENTER"
                    spacing="15">

                <Button
                        fx:id="micButton"
                        text="🎤 Mic"
                        prefWidth="120"
                        prefHeight="45"
                        onAction="#handleMic"/>

                <Button
                        text="📹 Camera"
                        prefWidth="120"
                        prefHeight="45"
                        disable="true"/>

                <Button
                        text="📞 Rời phòng"
                        prefWidth="120"
                        prefHeight="45"
                        onAction="#handleLeave"
                        style="-fx-background-color: #d93025; -fx-text-fill: white;"/>

            </HBox>

            <Label
                    fx:id="statusLabel"
                    style="-fx-text-fill: #aaaaaa;"/>

        </VBox>

    </bottom>

</BorderPane>